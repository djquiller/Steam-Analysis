# 复制为 .env 后填写；.env 已在 .gitignore 中，不会提交。

# --- MySQL 连接 ---
DB_HOST=127.0.0.1
DB_PORT=3306
# dwd/ads 两层所在的库（后端只连这个库）
DB_NAME=steam
# ods 层所在的库（只有 ETL 使用）
DB_ODS_NAME=steam_ods

# 后端使用：只读账号，仅对 steam 库有 SELECT 权限
DB_USER=api_reader
DB_PASSWORD=

# 采集与清洗使用：读写账号，对 steam 与 steam_ods 两个库有读写权限
ETL_DB_USER=etl_writer
ETL_DB_PASSWORD=

# --- Steam Web API（在线人数采集用，https://steamcommunity.com/dev/apikey） ---
STEAM_API_KEY=

# --- 本地数据目录（原始下载文件，已被 .gitignore 忽略） ---
DATA_DIR=data/raw
