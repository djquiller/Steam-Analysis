# 统一编辑器行为：全仓库 UTF-8（无 BOM）+ LF 换行
# VS Code 需安装 EditorConfig 插件；JetBrains 系列内置支持
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown 行尾两个空格表示换行，不能删
trim_trailing_whitespace = false

# Windows 脚本保持 CRLF，否则 cmd / 旧版 PowerShell 可能解析异常
[*.{bat,cmd,ps1}]
end_of_line = crlf
